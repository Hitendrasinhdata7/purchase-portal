# ---- Copy this file to .env and fill in real values before deploying ----
# .env is git-ignored and must NEVER be committed.

# Django
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your.ec2.public.ip

# CORS / CSRF: comma-separated origins, include the scheme (http:// or https://)
CORS_ALLOWED_ORIGINS=http://your.ec2.public.ip
CSRF_TRUSTED_ORIGINS=http://your.ec2.public.ip

# Set to True only once you have HTTPS working (see HTTPS upgrade steps)
SECURE_COOKIES=False

# Postgres
POSTGRES_DB=purchase_portal
POSTGRES_USER=purchase_portal
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
